# VITE_API_BASE_URL: Base URL for the existing Flask backend API.
# Default local development server runs at http://127.0.0.1:5000
VITE_API_BASE_URL=http://127.0.0.1:5000
# Google Maps Platform: enable Maps JavaScript API and restrict key by HTTP referrer.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_javascript_api_key

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Flask uses JWT_SECRET_KEY for JWT signing and for HMAC hashing of
# registration and password-reset OTPs. Set a unique random value locally;
# do not use the development placeholder or commit your actual secret.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET_KEY=<generated-secret>

# Web Push (optional until VAPID values are configured). Generate a P-256 key
# pair; keep the private key only in the backend environment:
#   openssl ecparam -name prime256v1 -genkey -noout -out vapid_private.pem
#   openssl ec -in vapid_private.pem -pubout -outform DER -out vapid_public.der
#   python -c "import base64; print(base64.urlsafe_b64encode(open('vapid_public.der','rb').read()[-65:]).decode().rstrip('='))"
# Set WEB_PUSH_VAPID_PUBLIC_KEY to the command's output and
# WEB_PUSH_VAPID_PRIVATE_KEY to the path of the PEM file mounted for the
# backend (for example, /run/secrets/vapid_private.pem). Do not commit the key.
# WEB_PUSH_VAPID_SUBJECT must be a contact URI such as mailto:admin@example.org.
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_VAPID_SUBJECT=

# Extension-agent activation email (required when admins select Email).
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SENDER=
EMAIL_SMTP_USE_TLS=true
EMAIL_SMTP_TIMEOUT_SECONDS=15
# Email provider: smtp, resend, or google_apps_script

# Resend HTTPS email API (required when EMAIL_PROVIDER=resend)
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
EMAIL_API_TIMEOUT_SECONDS=15

# Google Apps Script HTTPS email gateway (used on Render free tier)
EMAIL_PROVIDER=google_apps_script
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=
